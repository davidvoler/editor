FROM python:3.14-slim-bookworm
# RUN apt update &&  apt install  -y build-essential cargo
# RUN apk add --update musl-dev gcc cargo
# RUN pip install --upgrade pip
# RUN pip install bcrypt
RUN apt-get update \
    && apt-get -y install libpq-dev gcc \
    && pip install psycopg2

WORKDIR /tmp
COPY requirements.txt requirements.txt
RUN pip install -r requirements.txt
# Same path as on the host, so tracebacks are clickable in the VS Code terminal.
# WORKDIR creates the directory.
WORKDIR /Users/davidle/dev/tutorial/editor/server/src
